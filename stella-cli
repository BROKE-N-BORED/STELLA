#!/usr/bin/env bash
# STELLA command line — run with: bash stella-cli <command>
#   bash stella-cli profiles
#   bash stella-cli projects <profile>
#   bash stella-cli export <profile> <project> <dir>
#   bash stella-cli import <export-dir>
#   bash stella-cli create-profile <name> --tag <ollama-tag> --role <role>
#   bash stella-cli create-project <profile> <name>
#   bash stella-cli train <profile> <project>
#   bash stella-cli export-gguf <profile> <project> <dir>
#   bash stella-cli probe <profile> <project>
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve symlinks (the `stella` command is a symlink into this folder).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
cd "$DIR"

if [ -x "$DIR/.venv/bin/python" ]; then
  PY="$DIR/.venv/bin/python"
else
  PY="python3"
fi

exec "$PY" -m stella.cli "$@"
