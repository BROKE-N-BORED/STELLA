[Desktop Entry]
Type=Application
Version=1.0
Name=Repair Stella
Comment=Check the Stella install and repair what a move broke
Exec=python3 -c "import os,subprocess,sys; d=os.path.dirname(sys.argv[1]) or os.getcwd(); sys.exit(subprocess.call([sys.executable, os.path.join(d, 'repair_launcher.py')]))" %k
Icon=stella
Terminal=true
Categories=Utility;
StartupNotify=true
Keywords=repair;doctor;fix;Stella;
